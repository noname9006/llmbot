# ── Discord ───────────────────────────────────────────────────────────────────
# Bot #1 — Remote model (always-on VPS)
DISCORD_TOKEN_REMOTE=your_remote_bot_token_here
# Bot #2 — Local model (optional — leave blank to run in remote-only mode)
DISCORD_TOKEN_LOCAL=
# Comma-separated channel IDs to restrict the bots to. Leave empty for all channels.
ALLOWED_CHANNEL_IDS=          # comma-separated channel IDs, leave empty for all

# ── llama-server — Remote / VPS (Model 1, always-on) ─────────────────────────
# The bot will auto-launch llama-server on startup using the binary in llama/.
VPS_LLAMA_URL=http://localhost:8080/v1
VPS_MODEL_FILE=gemma-4-E4B-it-Q5_K_M.gguf

# Set to false to skip auto-launching llama-server (manage it externally instead)
VPS_LLAMA_ENABLED=true
# Path to llama-server binary
VPS_LLAMA_BIN=./llama/llama-server
# Full path to the GGUF model file for the remote (VPS) instance
VPS_MODEL_PATH=/path/to/your/vps-model.gguf

# ── Local agent — via Tailscale (manages the LOCAL model) ────────────────────
# The agent spawns/kills llama-server on the local machine.
LOCAL_AGENT_URL=http://<tailscale-ip>:3000
LOCAL_AGENT_TOKEN=your_secret_agent_token_here

# Direct URL to the local llama-server (port 8081, same Tailscale IP)
LOCAL_LLAMA_URL=http://<tailscale-ip>:8081/v1

# Model filename — looked up in the agent's LLAMA_MODEL_DIR
LOCAL_MODEL_FILE=your-local-model.Q4_K_M.gguf

# ── Availability polling ───────────────────────────────────────────────────────
# How often (ms) to poll the local agent /health endpoint. Default: 30000
LOCAL_HEALTH_POLL_INTERVAL_MS=30000

# ── SearXNG ───────────────────────────────────────────────────────────────────
SEARXNG_BASE_URL=http://your-searxng-instance
SEARCH_RESULT_COUNT=5

# ── Search controls ───────────────────────────────────────────────────────────
# Master switch: set to off to disable all search functionality
SEARCH=on

# auto: model's __SEARCH__ signal triggers search automatically
# command: search only happens when user types the search command
SEARCH_MODE=auto

# The command name for forced search. Must start with !
SEARCH_COMMAND=!search

# ── Inference Parameters ──────────────────────────────────────────────────────
LLM_TEMPERATURE=0.8
LLM_TOP_P=0.95
LLM_TOP_K=40
LLM_MIN_P=0.0
LLM_REPEAT_PENALTY=1.1          # old name LLM_REPETITION_PENALTY still accepted for backward compatibility
LLM_MAX_TOKENS=2048
LLM_REASONING_BUDGET=-1          # -1 = not sent (model default). 0 = disable reasoning. Positive = token cap.

# ── System Prompt ─────────────────────────────────────────────────────────────
# By default loaded from sysprompt_remote.txt / sysprompt_local.txt.
# Set this env var to override the remote prompt entirely.
SYSTEM_PROMPT=You are a helpful assistant.

# ── History ───────────────────────────────────────────────────────────────────
HISTORY_MAX_PAIRS=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Per-user: max N messages per sliding window (default: 5 per 30 s)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=30000

# Max simultaneous LLM calls across all users (default: 5)
MAX_CONCURRENT_REQUESTS=5

# ── Retries ───────────────────────────────────────────────────────────────────
# Retry failed LLM / SearXNG calls (exponential back-off, default: 3 attempts)
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=500

# ── LLM fetch timeout ─────────────────────────────────────────────────────────
# Maximum time (ms) to wait for a single /chat/completions response (default: 120 s)
LLM_FETCH_TIMEOUT_MS=120000

# ── Observability — HTTP health endpoint ──────────────────────────────────────
# Set to a port number to expose GET /health for uptime monitors. 0 = disabled.
HEALTH_PORT=9090

# ── Local bot presence ────────────────────────────────────────────────────────
# How long (ms) the local bot stays Online after finishing a task before returning to Idle (default: 30 s)
# LOCAL_PRESENCE_COOLDOWN_MS=30000

# How long (ms) the local model can be idle before being stopped. 0 = never auto-stop (default)
LOCAL_MODEL_IDLE_MS=0

# ── Per-model llama.cpp extra args ────────────────────────────────────────────
Falls back to LLAMA_EXTRA_ARGS if not set
LLAMA_EXTRA_ARGS_VPS=
LLAMA_EXTRA_ARGS_LOCAL=

# ── Per-model context size ────────────────────────────────────────────────────
# Falls back to LLAMA_CONTEXT_SIZE if not set
LLAMA_CONTEXT_SIZE_VPS=
LLAMA_CONTEXT_SIZE_LOCAL=

# ── Per-model fetch timeout (ms) ──────────────────────────────────────────────
# Falls back to LLM_FETCH_TIMEOUT_MS if not set
LLM_FETCH_TIMEOUT_MS_VPS=
LLM_FETCH_TIMEOUT_MS_LOCAL=

# ── Per-model inference parameters ───────────────────────────────────────────
# Each falls back to the global value (LLM_TEMPERATURE, etc.) if not set
LLM_TEMPERATURE_REMOTE=       
LLM_TOP_P_REMOTE=             
LLM_TOP_K_REMOTE=             
LLM_MIN_P_REMOTE=             
LLM_REPEAT_PENALTY_REMOTE=    
LLM_MAX_TOKENS_REMOTE=        
LLM_REASONING_BUDGET_REMOTE=  

LLM_TEMPERATURE_LOCAL=
LLM_TOP_P_LOCAL=
LLM_TOP_K_LOCAL=
LLM_MIN_P_LOCAL=
LLM_REPEAT_PENALTY_LOCAL=
LLM_MAX_TOKENS_LOCAL=
LLM_REASONING_BUDGET_LOCAL=