# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_token_here
ALLOWED_CHANNEL_IDS=          # comma-separated channel IDs, leave empty for all

# ── LLM Connection ────────────────────────────────────────────────────────────
LLM_BASE_URL=http://127.0.0.1:7860/v1
LLM_MODEL=your-model-name

# ── Mode ──────────────────────────────────────────────────────────────────────
# false = instruct mode (default), true = thinking mode
LLM_THINKING_MODE=false

# ── Inference Parameters ──────────────────────────────────────────────────────
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_PRESENCE_PENALTY=1.5
LLM_REPETITION_PENALTY=1.0
LLM_MAX_TOKENS=1024

# ── System Prompt ─────────────────────────────────────────────────────────────
# By default loaded from sysprompt.txt in the project root.
# Set this env var to override sysprompt.txt entirely.
# SYSTEM_PROMPT=You are a helpful assistant.

# ── History ───────────────────────────────────────────────────────────────────
HISTORY_MAX_PAIRS=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
