# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_token_here
ALLOWED_CHANNEL_IDS=          # comma-separated channel IDs, leave empty for all

# ── Ollama — VPS (Model 1, fallback) ─────────────────────────────────────────
VPS_OLLAMA_BASE_URL=http://localhost:11434
VPS_MODEL=phi4-mini

# ── Ollama — Local machine via Tailscale (Models 2 & 3) ───────────────────────
LOCAL_OLLAMA_BASE_URL=http://<tailscale-ip>:11434
LOCAL_MODEL_COMMON=your-common-model-name
LOCAL_MODEL_HEAVY=your-heavy-model-name

# ── Availability polling ───────────────────────────────────────────────────────
# How often (ms) to poll local Ollama /api/tags. Default: 30000
# LOCAL_HEALTH_POLL_INTERVAL_MS=30000

# ── SearXNG ───────────────────────────────────────────────────────────────────
SEARXNG_BASE_URL=http://your-searxng-instance
# SEARCH_RESULT_COUNT=5

# ── Inference Parameters ──────────────────────────────────────────────────────
LLM_TEMPERATURE=0.8
LLM_TOP_P=0.95
LLM_TOP_K=40
LLM_MIN_P=0.0
LLM_REPETITION_PENALTY=1.1
LLM_MAX_TOKENS=2048

# ── System Prompt ─────────────────────────────────────────────────────────────
# By default loaded from sysprompt.txt in the project root.
# Set this env var to override sysprompt.txt entirely.
# SYSTEM_PROMPT=You are a helpful assistant.

# ── History ───────────────────────────────────────────────────────────────────
HISTORY_MAX_PAIRS=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
