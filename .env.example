# ── Discord ───────────────────────────────────────────────────────────────────
# Bot #1 — Remote model (always-on VPS)
DISCORD_TOKEN_REMOTE=your_remote_bot_token_here
# Bot #2 — Local model (optional — leave blank to run in remote-only mode)
DISCORD_TOKEN_LOCAL=
# Comma-separated channel IDs to restrict the bots to. Leave empty for all channels.
ALLOWED_CHANNEL_IDS=          # comma-separated channel IDs, leave empty for all

# ── llama-server — Remote / VPS (Model 1, always-on) ─────────────────────────
# The bot will auto-launch llama-server on startup using the binary in llama/.
VPS_LLAMA_URL=http://localhost:8080/v1
VPS_MODEL_FILE=

# Set to false to skip auto-launching llama-server (manage it externally instead)
VPS_LLAMA_ENABLED=true
# Path to llama-server binary
VPS_LLAMA_BIN=./llama/llama-server
# Full path to the GGUF model file for the remote (VPS) instance
VPS_MODEL_PATH=/path/to/your/vps-model.gguf

# ── Local agent — via Tailscale (manages the LOCAL model) ────────────────────
# The agent spawns/kills llama-server on the local machine.
LOCAL_AGENT_URL=http://<tailscale-ip>:3000
LOCAL_AGENT_TOKEN=your_secret_agent_token_here

# Direct URL to the local llama-server (port 8081, same Tailscale IP)
LOCAL_LLAMA_URL=http://<tailscale-ip>:8081/v1

# Model filename — looked up in the agent's LLAMA_MODEL_DIR
LOCAL_MODEL_FILE=your-local-model.Q4_K_M.gguf

# ── Availability polling ───────────────────────────────────────────────────────
# How often (ms) to poll the local agent /health endpoint. Default: 30000
LOCAL_HEALTH_POLL_INTERVAL_MS=30000

# ── SearXNG ───────────────────────────────────────────────────────────────────
SEARXNG_BASE_URL=http://your-searxng-instance
SEARCH_RESULT_COUNT=5

# ── Search controls ───────────────────────────────────────────────────────────
# Master switch: set to off to disable all search functionality
SEARCH=on

# auto: model's __SEARCH__ signal triggers search automatically
# command: search only happens when user types the search command
SEARCH_MODE=auto

# The command name for forced search. Must start with !
SEARCH_COMMAND=!search

# ── Complexity detection ──────────────────────────────────────────────────────
# Minimum character count for a prompt to be considered "long" (default: 300)
# COMPLEXITY_PROMPT_LENGTH=300

# Comma-separated keywords that flag a code-related request
# COMPLEXITY_KEYWORDS_CODE=debug,refactor,implement,algorithm,function,class,compile,syntax,error,exception,stack trace,regex,sql,query,optimize

# Comma-separated keywords that flag a planning / architecture request
# COMPLEXITY_KEYWORDS_PLAN=architecture,design,plan,roadmap,strategy,system design,how to build,how to implement,step by step,guide me,walk me through

# ── Inference Parameters ──────────────────────────────────────────────────────
LLM_TEMPERATURE=0.8
LLM_TOP_P=0.95
LLM_TOP_K=40
LLM_MIN_P=0.0
LLM_REPEAT_PENALTY=1.1          # old name LLM_REPETITION_PENALTY still accepted for backward compatibility
LLM_MAX_TOKENS=2048
LLM_REASONING_BUDGET=-1          # -1 = not sent (model default). 0 = disable reasoning. Positive = token cap.

# ── System Prompt ─────────────────────────────────────────────────────────────
# Load priority (highest to lowest):
#   1. sysprompt_remote.txt / sysprompt_local.txt  (file takes precedence)
#   2. SYSTEM_PROMPT_REMOTE / SYSTEM_PROMPT_LOCAL  (env-var override, used only if file is absent)
#   3. SYSTEM_PROMPT                               (shared fallback for both roles)
#   4. Hardcoded default
# Keep all three commented out to rely on your sysprompt_*.txt files.
# SYSTEM_PROMPT=You are a helpful assistant.
# SYSTEM_PROMPT_REMOTE=
# SYSTEM_PROMPT_LOCAL=

# ── History ───────────────────────────────────────────────────────────────────
HISTORY_MAX_PAIRS=10

# Max input tokens before history trimming kicks in (0 = disabled).
# Separate limits per model — each falls back to MAX_INPUT_TOKENS.
# MAX_INPUT_TOKENS=0
# MAX_INPUT_TOKENS_REMOTE=0
# MAX_INPUT_TOKENS_LOCAL=0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# Set to true to log raw LLM I/O (input messages and output text)
# LOG_RAW=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Per-user: max N messages per sliding window (default: 5 per 30 s)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=30000

# Max simultaneous LLM calls across all users (default: 1)
MAX_CONCURRENT_REQUESTS=1

# ── Retries ───────────────────────────────────────────────────────────────────
# Retry failed LLM / SearXNG calls (exponential back-off, default: 3 attempts)
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=500

# ── LLM fetch timeout ─────────────────────────────────────────────────────────
# Maximum time (ms) to wait for a single /chat/completions response (default: 120 s)
LLM_FETCH_TIMEOUT_MS=120000

# ── Observability — HTTP health endpoint ──────────────────────────────────────
# Set to a port number to expose GET /health for uptime monitors. 0 = disabled.
HEALTH_PORT=9090

# Optional bearer token to protect the /health endpoint. Empty = no auth.
# HEALTH_TOKEN=

# ── Local bot presence ────────────────────────────────────────────────────────
# How long (ms) the local bot stays Online after finishing a task before returning to Idle (default: 30 s)
# LOCAL_PRESENCE_COOLDOWN_MS=30000

# How long (ms) the local model can be idle before being stopped. 0 = never auto-stop (default)
LOCAL_MODEL_IDLE_MS=0

# ── Per-model llama.cpp extra args ────────────────────────────────────────────
# Falls back to LLAMA_EXTRA_ARGS if not set
LLAMA_EXTRA_ARGS_REMOTE=
LLAMA_EXTRA_ARGS_LOCAL=

# ── Per-model context size ────────────────────────────────────────────────────
# Falls back to LLAMA_CONTEXT_SIZE if not set
LLAMA_CONTEXT_SIZE_REMOTE=
LLAMA_CONTEXT_SIZE_LOCAL=

# ── Per-model fetch timeout (ms) ──────────────────────────────────────────────
# Falls back to LLM_FETCH_TIMEOUT_MS if not set
LLM_FETCH_TIMEOUT_MS_REMOTE=
LLM_FETCH_TIMEOUT_MS_LOCAL=

# ── Per-model inference parameters ───────────────────────────────────────────
# Each falls back to the global value (LLM_TEMPERATURE, etc.) if not set
LLM_TEMPERATURE_REMOTE=       
LLM_TOP_P_REMOTE=             
LLM_TOP_K_REMOTE=             
LLM_MIN_P_REMOTE=             
LLM_REPEAT_PENALTY_REMOTE=    
LLM_MAX_TOKENS_REMOTE=        
LLM_REASONING_BUDGET_REMOTE=  

LLM_TEMPERATURE_LOCAL=
LLM_TOP_P_LOCAL=
LLM_TOP_K_LOCAL=
LLM_MIN_P_LOCAL=
LLM_REPEAT_PENALTY_LOCAL=
LLM_MAX_TOKENS_LOCAL=
LLM_REASONING_BUDGET_LOCAL=

# ── MCP (Model Context Protocol) ─────────────────────────────────────────────
# Master switch — set to true to enable MCP tool calling.
# Requires the LLM backend (llama-server) to support OpenAI tool-calling format.
MCP_ENABLED=false

# Trust boundary note — MCP labels and tool names:
#   Labels (MCP_*_LABEL) are operator-controlled text injected verbatim into the
#   system prompt.  Treat them as trusted configuration — do not copy values from
#   untrusted sources (e.g. user input or third-party APIs).
#   Values are sanitized at runtime (control characters stripped, max 100 chars),
#   but keeping labels short, descriptive, and free of special characters is best
#   practice to keep the system prompt predictable.

# ── CoinGecko MCP ─────────────────────────────────────────────────────────────
# Enable the CoinGecko MCP server (crypto prices, market data, trending coins …)
# Docs: https://docs.coingecko.com/docs/ai-agent-hub/mcp-server
MCP_COINGECKO_ENABLED=false
# CoinGecko MCP server URL (defaults to the official endpoint)
MCP_COINGECKO_URL=https://mcp.api.coingecko.com/
# Topic label injected into system prompt so the model knows when to use this MCP
MCP_COINGECKO_LABEL=          # defaults to "crypto prices and market data"
# Optional: CoinGecko Pro API key (leave empty for the free public endpoint)
MCP_COINGECKO_API_KEY=

# ── GitBook MCP (multiple documentation spaces) ──────────────────────────────
# Enable GitBook MCP servers for published documentation spaces.
# Docs: https://gitbook.com/docs/ai-and-search/mcp-servers-for-published-docs
MCP_GITBOOK_ENABLED=false
# GitBook #1
# You can use a friendly docs URL (e.g. https://docs.example.com/project/);
# the app auto-appends /~gitbook/mcp if needed.
MCP_GITBOOK_URL_1=
MCP_GITBOOK_LABEL_1=          # Topic label, e.g. "Botanix" — injected into system prompt
MCP_GITBOOK_TOKEN_1=
# GitBook #2
MCP_GITBOOK_URL_2=
MCP_GITBOOK_LABEL_2=
MCP_GITBOOK_TOKEN_2=
# Shared settings (apply to all GitBook servers unless per-instance token is set)
# Transport: streamable-http (default) or sse
MCP_GITBOOK_TRANSPORT=streamable-http
MCP_GITBOOK_TOKEN=
# Legacy single-URL mode (deprecated — use MCP_GITBOOK_URL_1 instead)
# MCP_GITBOOK_URL=

# ── Custom MCP servers (up to 10) ─────────────────────────────────────────────
# Add additional MCP servers using numbered groups:
# MCP_SERVER_1_NAME=myserver
# MCP_SERVER_1_URL=https://example.com/mcp
# MCP_SERVER_1_LABEL=                     # topic label injected into system prompt
# MCP_SERVER_1_TRANSPORT=streamable-http   # or: sse
# MCP_SERVER_1_API_KEY=                    # sent as x-api-key header if set
