# ── Agent server ──────────────────────────────────────────────────────────────
PORT=3000

# Bearer token — must match LOCAL_AGENT_TOKEN in the bot's .env
AGENT_TOKEN=your_secret_agent_token_here

# ── llama-server binary ───────────────────────────────────────────────────────
# Full path to the llama-server executable
LLAMA_SERVER_BIN=F:\AI\llama.cpp\llama-server.exe

# Port llama-server will listen on
LLAMA_SERVER_PORT=8081

# Directory containing model files (filenames come from the bot's config)
LLAMA_MODEL_DIR=F:\AI\.models

# ── GPU (Vulkan / CUDA) ───────────────────────────────────────────────────────
# Default number of layers to offload to GPU. Used when no per-model override is set.
# Use 99 to offload all layers (recommended if the model fits in VRAM).
LLAMA_GPU_LAYERS=99

# Per-model GPU layer overrides (optional).
# If set, these take priority over LLAMA_GPU_LAYERS for the respective role.
# Useful when models differ in size and don't all fit fully in VRAM.
# LLAMA_GPU_LAYERS_COMMON=99
# LLAMA_GPU_LAYERS_HEAVY=32

# Context window size passed to llama-server (optional, omit to use model default)
# LLAMA_CONTEXT_SIZE=4096

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
