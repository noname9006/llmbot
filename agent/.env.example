# ── Agent server ──────────────────────────────────────────────────────────────
PORT=3000

# Bearer token — must match LOCAL_AGENT_TOKEN in the bot's .env
AGENT_TOKEN=your_secret_agent_token_here

# ── llama-server binary ───────────────────────────────────────────────────────
# Full path to the llama-server executable
LLAMA_SERVER_BIN=F:\AI\llama.cpp\llama-server.exe

# Port llama-server will listen on
LLAMA_SERVER_PORT=8081

# Directory containing model files (filenames come from the bot's config)
LLAMA_MODEL_DIR=F:\AI\.models

# ── GPU (Vulkan / CUDA) ───────────────────────────────────────────────────────
# Default number of layers to offload to GPU (for reference / manual use only).
# Use -ngl in LLAMA_EXTRA_ARGS_COMMON / LLAMA_EXTRA_ARGS_HEAVY instead.
LLAMA_GPU_LAYERS=99

# Context window size passed to llama-server (global fallback, omit to use model default)
LLAMA_CONTEXT_SIZE=

# Extra flags passed verbatim to llama-server (global fallback, space-separated).
# Example: --flash-attn --cache-type-k q4_0 --cache-type-v q4_0 -b 256 -ub 256 --threads 6
LLAMA_EXTRA_ARGS=

# ── Per-model extra args (takes priority over bot-sent values) ────────────────
# If set, these override whatever the bot sends for the respective role.
# Include -ngl here to control GPU layer offload per model.
# LLAMA_EXTRA_ARGS_COMMON=--no-mmap --flash-attn on --reasoning on -ngl 35 -ctk q8_0 -ctv q8_0 -b 512 -ub 256 -t 4 --reasoning-budget 64 --reasoning-budget-message "Summary:"
# LLAMA_EXTRA_ARGS_HEAVY=--no-mmap --flash-attn on --reasoning on -ngl 20 -ctk q8_0 -ctv q8_0 -b 512 -ub 256 -t 4 --reasoning-budget 512 --reasoning-budget-message "Summary:"

# ── Per-model context size (takes priority over bot-sent values) ──────────────
# LLAMA_CONTEXT_SIZE_COMMON=8192
# LLAMA_CONTEXT_SIZE_HEAVY=8192

# ── Per-model fetch timeout (ms) ──────────────────────────────────────────────
# LLM_FETCH_TIMEOUT_MS_COMMON=60000
# LLM_FETCH_TIMEOUT_MS_HEAVY=600000

# ── Per-model inference parameters ───────────────────────────────────────────
# LLM_TEMPERATURE_COMMON=0.95
# LLM_TOP_P_COMMON=0.95
# LLM_TOP_K_COMMON=64
# LLM_MIN_P_COMMON=0.0
# LLM_REPEAT_PENALTY_COMMON=1
# LLM_MAX_TOKENS_COMMON=512

# LLM_TEMPERATURE_HEAVY=0.8
# LLM_TOP_P_HEAVY=0.95
# LLM_TOP_K_HEAVY=64
# LLM_MIN_P_HEAVY=0.0
# LLM_REPEAT_PENALTY_HEAVY=1.05
# LLM_MAX_TOKENS_HEAVY=1024

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
